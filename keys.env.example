# Copy to keys.env (gitignored) to build the APK with API keys already set.
# Keys typed in Settings → Map server keys take precedence. Leave out the ones you don't have.
# Environment variables with the same names work too.
THUNDERFOREST_KEY=
MAPBOX_KEY=
TRACESTRACK_KEY=
OS_KEY=
AZURE_KEY=

# Optional release signing (otherwise release builds use the local debug key).
# CARTOGLISS_KEYSTORE is a path, relative to the repo root or absolute.
CARTOGLISS_KEYSTORE=
CARTOGLISS_KEYSTORE_PASSWORD=
CARTOGLISS_KEY_ALIAS=
CARTOGLISS_KEY_PASSWORD=
